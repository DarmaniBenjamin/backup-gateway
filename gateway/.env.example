# Agent API: what the agents connect to. 0.0.0.0 = every network address of this computer.
# 127.0.0.1 = only this computer (and Caddy or a tunnel on it).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Leave empty: install links use this computer's own addresses (found by themselves, every one of
# them) and, once the Certificate page has one that works, its domain with https. Set it only to
# force one address for every install, e.g. http://192.168.1.10:8080
GATEWAY_PUBLIC_URL=

# Set to 1 when agents reach the gateway through a Cloudflare Tunnel or Caddy on this same computer
# (deploy/install.sh does it): the caller's real address then comes from their header, for the
# per-address limits and the logs. Leave it empty when agents connect straight to GATEWAY_PORT.
GATEWAY_TRUST_PROXY=

# The web UI on the gateway's address: by IP until the Domain & SSL page has a domain that works,
# then only at https://<domain> (by IP it's blocked). Set 0 to keep it on this computer only.
GATEWAY_WEB_UI_ONLINE=

# Admin web UI: for you only. Keep this on 127.0.0.1 (or a management VLAN later) — never expose it to the internet.
GATEWAY_ADMIN_HOST=127.0.0.1
GATEWAY_ADMIN_PORT=8090

# Where the gateway keeps its database and backup chunks
GATEWAY_DATA_DIR=./data

# How long a new enrollment code stays valid, in minutes
GATEWAY_CODE_TTL_MINUTES=60

# Quarantine engine: freeze a device when this many suspicious files (or deleted files)
# arrive within the window, in minutes
GATEWAY_FREEZE_WINDOW_MINUTES=10
GATEWAY_FREEZE_SUSPICIOUS_FILES=5
GATEWAY_FREEZE_DELETED_FILES=100

# Antivirus: ClamAV is found by itself at its usual socket. Set this to its socket path
# (/run/clamav/clamd.ctl) or host:port (127.0.0.1:3310) if it's somewhere else, or "off".
# GATEWAY_CLAMAV=

# Log level: debug, info, warn, error
GATEWAY_LOG_LEVEL=info