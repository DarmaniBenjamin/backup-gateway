# Agent API: address the agents connect to.
# 127.0.0.1 = only this computer can connect (safe for development)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Admin web UI: for you only. Keep this on 127.0.0.1 (or a management VLAN later) — never expose it to the internet.
GATEWAY_ADMIN_HOST=127.0.0.1
GATEWAY_ADMIN_PORT=8090

# Where the gateway keeps its database and backup chunks
GATEWAY_DATA_DIR=./data

# How long a new enrollment code stays valid, in minutes
GATEWAY_CODE_TTL_MINUTES=60

# Log level: debug, info, warn, error
GATEWAY_LOG_LEVEL=info