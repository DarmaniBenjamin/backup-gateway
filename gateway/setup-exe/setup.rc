// Resources for BackupAgentSetup.exe: its manifest (asks for administrator rights) and the version
// details Windows shows under Properties > Details. Built with setup.c.
#include <windows.h>

1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Protonic Solutions"
      VALUE "FileDescription", "Backup Agent Setup"
      VALUE "FileVersion", "2.0.0.0"
      VALUE "InternalName", "BackupAgentSetup"
      VALUE "LegalCopyright", "Copyright (C) 2026 Protonic Solutions"
      VALUE "OriginalFilename", "BackupAgentSetup.exe"
      VALUE "ProductName", "Backup Agent"
      VALUE "ProductVersion", "2.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
