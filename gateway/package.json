{
  "name": "backup-gateway-server",
  "version": "0.7.0",
  "description": "Backup gateway: enrolls agents, receives changes, versions, checks and uploads",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "new-code": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/new-code.js",
    "devices": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/devices.js",
    "versions": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/versions.js",
    "restore": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/restore.js",
    "jobs": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/jobs.js",
    "verify": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/verify.js",
    "create-admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/create-admin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
