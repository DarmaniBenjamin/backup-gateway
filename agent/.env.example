# Folder the agent watches and backs up (absolute path)
AGENT_WATCH_DIR=/home/YOUR_USERNAME/Documents/backup-gateway/test-data/client-files

# Where the agent keeps its own database and identity key (must NOT be inside the watched folder)
AGENT_DATA_DIR=./data

# Name shown in logs and later in the dashboard
AGENT_DEVICE_NAME=dev-laptop

# Address of the backup gateway
AGENT_GATEWAY_URL=http://127.0.0.1:8080

# One-time enrollment code from the gateway (only needed the first time; remove it afterwards)
AGENT_ENROLL_CODE=

# Log level: debug, info, warn, error
AGENT_LOG_LEVEL=info