# The first folder to back up (absolute path). Only used the very first time the agent starts;
# after that, backup folders are added and removed from the gateway's web UI. Can be left empty.
AGENT_WATCH_DIR=/home/YOUR_USERNAME/Documents/backup-gateway/test-data/client-files

# Allowed areas: the ONLY places the gateway may back up or browse on this device. Set here on
# the device, so even a compromised gateway can't reach anything else. Separate several with ;
#   Windows example: C:\Users;D:\Data      Synology example: /volume1/Accounting;/volume1/Shared
# Empty = the AGENT_WATCH_DIR folder, or the user's home folder if that's empty too.
AGENT_ALLOWED_PATHS=/home/YOUR_USERNAME/Documents/backup-gateway/test-data

# Where the agent keeps its own database and identity key (never backed up itself)
AGENT_DATA_DIR=./data

# Name shown in logs and later in the dashboard
AGENT_DEVICE_NAME=dev-laptop

# Address of the backup gateway
AGENT_GATEWAY_URL=http://127.0.0.1:8080

# One-time enrollment code from the gateway (only needed the first time; remove it afterwards)
AGENT_ENROLL_CODE=

# Log level: debug, info, warn, error
AGENT_LOG_LEVEL=info
